# Baseline .gitignore, from the CODEBASE baseline in hark_system (archived 2026-10-19,
# now hark_system_archive); this repository's own lines are under "# This repo".
# OS / editors
Thumbs.db
desktop.ini
.DS_Store
~$*
*.tmp
# Rhino / Grasshopper: models live outside git; milestones go to GitHub Releases (GIT-04)
*.3dm
*.3dmbak
*.rhl
# Exports, renders, design sources, archives, video
*.stl
*.obj
*.fbx
*.3ds
*.c4d
*.dwg
*.dxf
*.exr
*.psd
*.ai
*.zip
*.rar
*.7z
*.mp4
*.mov
# Python
__pycache__/
*.pyc
.venv/
# Node / web builds
node_modules/
.next/
out/
dist/
.env
.env*.local
*.log
# Local agent settings
.claude/settings.local.json
# This repo
# PDFs stay out of the repository for now (see planning/decisions.md).
*.pdf
# Working files for a site live in its source/ folder, beside site/; nothing
# in source/ is published, and nothing in it is committed except its README.
web/*/source/**
!web/*/source/README.md
